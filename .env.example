# Banco de dados (Railway PostgreSQL ou Neon)
DATABASE_URL="postgresql://usuario:senha@host/db?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host/db?sslmode=require"

# Resend (emails transacionais) — https://resend.com
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="ASTRO <pedidos@seudominio.com.br>"

# Cloudinary (imagens dos produtos) — https://cloudinary.com
CLOUDINARY_CLOUD_NAME="seu-cloud"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="seu-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="seu-cloud"

# Banco Inter PJ — PIX API (configurar após aprovação)
# Cadastre em: https://developers.inter.com.br
INTER_CLIENT_ID="..."
INTER_CLIENT_SECRET="..."
INTER_PIX_KEY="..."           # Sua chave PIX (CNPJ, e-mail ou aleatória)
INTER_CERT_BASE64="..."       # Conteúdo do .crt em base64
INTER_KEY_BASE64="..."        # Conteúdo do .key em base64

# WhatsApp via Z-API (opcional) — https://z-api.io
